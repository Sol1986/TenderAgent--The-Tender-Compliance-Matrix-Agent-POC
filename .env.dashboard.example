# Copy to .env.dashboard and set DASHBOARD_ENV_FILE=.env.dashboard in PowerShell.
# Existing process variables and .env values take precedence. Do not commit secrets.
# OPENAI_API_KEY belongs in the existing .env or your process environment.
OPENAI_MODEL=gpt-5.6-luna
DEMO_SAMPLE_PATH=tender.PDF
DEMO_CORS_ORIGINS=http://localhost:3000
DEMO_RETENTION_SECONDS=3600
DEMO_MAX_TERMINAL_RUNS=10
DEMO_HEARTBEAT_SECONDS=15
DEMO_GRAPH_CONCURRENCY=4
DEMO_MAX_WORKERS=500
DEMO_MAX_INPUT_CHARACTERS=2000000
DEMO_LLM_TIMEOUT_SECONDS=120
DEMO_LLM_MAX_RETRIES=2
